DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/saturday_signal

# LLM provider for chat. Leave everything blank to run the deterministic
# offline composer. Set a key and the matching provider is auto-detected;
# set LLM_PROVIDER (mock | anthropic | openai) to force a choice.
#
# Most questions never reach a provider: routing serves next-game briefs,
# schedule scans, source readiness and curated team notes from the composer for
# free, and escalates only what needs synthesis (src/server/chat/routing.ts).
#
# SPEND CEILING IS NOT CONFIGURED HERE. It is a monthly limit set on the
# Anthropic workspace, which is the only place it can actually be enforced —
# an application-side check races itself and cannot see spend it failed to
# record. Set it on a DEDICATED, non-default workspace: custom monthly limits
# require one, and an org-wide limit would throttle every other project on the
# account. The llm_usage table is attribution only.
# Auto-detection prefers Anthropic whenever ANTHROPIC_API_KEY is set, so set
# this explicitly when both keys exist or the OpenAI credits sit unused.
LLM_PROVIDER=openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Also enables approved-domain live reporting for named-subject evidence gaps.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Soft monthly ceiling in USD. Trips before the provider's own limit and
# degrades to composer answers instead of provider errors, so a fan sees a
# working chat box rather than a broken one. "off" disables it and trusts the
# provider limit alone. Fails open: an unreadable ledger does not block chat.
LLM_MONTHLY_BUDGET_USD=25

# Answer cache. Only escalated, accepted answers are stored, keyed to the exact
# source material behind them — a weekly package or schedule rebuild retires
# every row for that team automatically. Needs DATABASE_URL; without one the
# cache is a silent no-op.
#
# Exact match always works. The semantic tier additionally needs a real
# embedding provider, because the offline embedder is a hash and similarity
# between its vectors is meaningless. Threshold is clamped to [0.9, 1].
CHAT_CACHE=
CHAT_CACHE_SIMILARITY=0.97

# Embeddings for pgvector retrieval (used by db:seed + chat when DATABASE_URL is
# set). Blank runs the deterministic offline embedder; OPENAI_API_KEY enables
# the OpenAI embedder automatically. Force with EMBEDDINGS_PROVIDER (mock | openai).
EMBEDDINGS_PROVIDER=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional live sports data (CollegeFootballData.com)
CFBD_API_KEY=

# Absolute origin used for canonical links, Open Graph, robots, and sitemap.
# Leave blank on Vercel: previews then resolve to themselves instead of
# claiming to be production. Set it explicitly anywhere else.
NEXT_PUBLIC_SITE_URL=

# Gates the money fields on /api/health. Without it those fields are withheld
# from everyone, which is the intended default — the endpoint is public and
# unauthenticated, and month-to-date spend is business data. Send it as the
# x-health-token header. Generate with: openssl rand -hex 32
HEALTH_TOKEN=

# Alerting. Without RESEND_API_KEY every alert is a log line and nothing is
# emailed, which is the intended state locally and in CI. Only production
# sends mail unless ALERT_FORCE=1.
#
# Swapping the recipient is this one variable. See docs/engineering-standards.md.
RESEND_API_KEY=
ALERT_EMAIL_TO=dibbleconnor@gmail.com
ALERT_EMAIL_FROM=alerts@sectiononesports.com
